<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="list_view_custom_config_rule_own_or_shared" model="ir.rule">
        <field name="name">Custom List Layouts: own or shared</field>
        <field name="model_id" ref="model_list_view_custom_config"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="list_calculated_column_rule_own_or_shared" model="ir.rule">
        <field name="name">Calculated Columns: follow parent layout visibility</field>
        <field name="model_id" ref="model_list_calculated_column"/>
        <field name="domain_force">
            ['|', ('config_id.user_id', '=', user.id), ('config_id.shared', '=', True)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
